# --- Database ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=products_db

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
CACHE_TTL_SECONDS=300

# --- Uploads ---
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=10

# --- JWT ---
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- URLs (used for OAuth redirects and email links) ---
FRONTEND_URL=http://localhost:3000
BASE_URL=http://localhost:3001

# --- Google OAuth ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must exactly match GOOGLE_CALLBACK_URL below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# --- SMTP (used for OTP / forgot-password / admin invite emails) ---
# Example for Gmail: create an "App Password" at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Product Manager
SMTP_USE_TLS=true

OTP_EXPIRE_MINUTES=10
INVITATION_EXPIRE_HOURS=72

# Comma-separated emails auto-promoted to SUPER_ADMIN when they register/log in.
# Set this to YOUR email before first run so you can access the super-admin panel.
SUPER_ADMIN_EMAILS=owner@example.com

CORS_ORIGINS=["http://localhost:3000","http://frontend:3000"]
