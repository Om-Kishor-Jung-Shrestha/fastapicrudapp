# Must be reachable from the USER'S BROWSER (not just from inside Docker),
# so keep this as localhost when running via docker-compose on your machine.
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_FILE_URL=http://localhost:3001

# Must match backend's GOOGLE_CLIENT_ID (same Google OAuth client)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
